# ==================================================
# SENTICAL AI ENVIRONMENT VARIABLES
# ==================================================

# DATABASE (PostgreSQL 16)
DATABASE_URL="postgresql://sentical:sentical_password@localhost:5432/sentical_db?schema=public"

# REDIS (Cache & BullMQ)
REDIS_URL="redis://localhost:6379"

# API SERVER CONFIGURATION
PORT=4000
NODE_ENV="development"
AUTH_SECRET="super-secret-auth-key-change-in-production-min-32-chars"
CLIENT_ORIGINS="http://localhost:3000,http://localhost:5173"

# META WHATSAPP CLOUD API
META_APP_ID="your_meta_app_id"
META_APP_SECRET="your_meta_app_secret"
META_VERIFY_TOKEN="your_meta_verify_token"
META_PHONE_NUMBER_ID="your_phone_number_id"
META_WHATSAPP_BUSINESS_ACCOUNT_ID="your_waba_id"
META_SYSTEM_USER_ACCESS_TOKEN="your_access_token"

# PAYMENTS
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# STORAGE (Cloudflare R2 / AWS S3)
R2_ACCOUNT_ID="your_r2_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET="sentical-assets"
R2_PUBLIC_URL="https://assets.sentical.ai"

# AI SERVICES
OPENAI_API_KEY="sk-proj-your_openai_api_key"
ANTHROPIC_API_KEY="sk-ant-your_anthropic_api_key"

# APPLICATIONS PORT MAPPING
MARKETING_PORT=3000
WEB_PORT=5173
API_PORT=4000
